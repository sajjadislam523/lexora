# Lexora environment variables.
# Copy to .env.local for development:  cp .env.example .env.local
# Never commit real secrets. Server-only variables must NOT use the NEXT_PUBLIC_ prefix.

# ── Database ────────────────────────────────────────────────────────────────
# Development: the Docker database from docker-compose.yml (pnpm db:up).
# Production (Neon): the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgres://lexora@localhost:5432/lexora"
# Production (Neon): the DIRECT connection string, used only for migrations.
# Optional in development (falls back to DATABASE_URL).
# DATABASE_URL_UNPOOLED=""

# ── Authentication (Better Auth) ────────────────────────────────────────────
# At least 32 random characters. Generate one with:  openssl rand -base64 32
# Use a different value in every environment.
BETTER_AUTH_SECRET="replace-me-with-at-least-32-random-characters"
# The public URL of the app. Required in production (e.g. https://lexora.app).
BETTER_AUTH_URL="http://localhost:3000"

# ── Optional AI (Phase 9) ───────────────────────────────────────────────────
# Lexora works fully without AI. Leave AI_PROVIDER as "none".
# AI_PROVIDER="none"   # none | anthropic | openai | local
# AI_API_KEY=""        # only required when AI_PROVIDER is not "none"
